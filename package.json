{
  "name": "stock-market-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "src",
    "server",
    "shared"
  ],
  "scripts": {
    "build": "bun run --cwd src build",
    "dev": "bun run server/orchestrator.ts",
    "test": "bun run test:phase1",
    "test:unit": "bun test server/data server/domain server/hooks server/infra shared src",
    "test:integration": "bun test server/modules/paper-trading/repository.integration.test.ts server/modules/paper-trading/service.integration.test.ts",
    "test:concurrency": "bun test server/modules/paper-trading/concurrency.integration.test.ts",
    "test:capabilities": "bun test server/modules/capabilities/capabilities.integration.test.ts",
    "test:workspace": "bun test server/modules/workspace/tenant-isolation.integration.test.ts",
    "test:alerts": "bun test server/modules/alerts/alerts.integration.test.ts",
    "test:scorecard": "bun test server/modules/analysis/scorecard.integration.test.ts",
    "test:peers": "bun test server/modules/peers/peers.integration.test.ts",
    "test:breadth": "bun test server/modules/market-breadth/breadth.integration.test.ts",
    "test:screener-dsl": "bun test server/modules/screener-dsl/screener-dsl.integration.test.ts",
    "test:backtest-v2": "bun test server/modules/backtest/backtest-v2.integration.test.ts",
    "test:data-quality": "bun test server/modules/data-quality/data-quality.integration.test.ts",
    "test:migration-0013": "bun test server/db/migrations/0013-upgrade.integration.test.ts",
    "test:migration-0015": "bun test server/db/migrations/0015-upgrade.integration.test.ts",
    "test:migration-0016": "bun test server/db/migrations/0016-upgrade.integration.test.ts",
    "test:migration-0017": "bun test server/db/migrations/0017-upgrade.integration.test.ts",
    "test:migration-0018": "bun test server/db/migrations/0018-upgrade.integration.test.ts",
    "test:options": "bun test server/data/sources/angelone/client.test.ts server/modules/options/repository.test.ts server/workers/ingestion-engine/pipelines/options-chain-pipeline.test.ts server/modules/options/read-model.test.ts server/api/trpc/routers/options.test.ts server/api/trpc/routers/ingestion.test.ts",
    "test:strategy-jobs": "bun test server/modules/strategy-jobs/strategy-jobs.integration.test.ts",
    "test:strategy-jobs-postgres": "bun test server/modules/strategy-jobs/strategy-jobs.postgres.integration.test.ts",
    "test:strategy-optimisation": "bun test server/modules/strategy-optimisation/sweeps.integration.test.ts server/modules/strategy-optimisation/walk-forward.integration.test.ts",
    "test:strategy-deployments": "bun test server/modules/strategy-deployments/deployments.integration.test.ts",
    "test:strategy-replay": "bun test server/modules/strategy-replay/replay.integration.test.ts",
    "test:portfolio-backtest": "bun test server/domain/strategy/portfolio-runner.test.ts",
    "test:strategy-engine": "bun test server/domain/strategy/ast-evaluator.test.ts server/domain/strategy/reproducibility.test.ts server/domain/strategy/look-ahead.test.ts",
    "test:phase1": "bun run test:unit && bun run test:integration && bun run test:concurrency",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:concurrency && bun run test:capabilities && bun run test:workspace && bun run test:alerts && bun run test:scorecard && bun run test:peers && bun run test:breadth && bun run test:screener-dsl && bun run test:backtest-v2 && bun run test:data-quality && bun run test:migration-0013 && bun run test:migration-0015 && bun run test:migration-0016 && bun run test:migration-0017 && bun run test:migration-0018 && bun run test:options && bun run test:strategy-engine && bun run test:strategy-jobs && bun run test:strategy-jobs-postgres && bun run test:strategy-optimisation && bun run test:strategy-deployments && bun run test:strategy-replay && bun run test:portfolio-backtest",
    "worker:backtest": "bun run server/workers/backtest-worker.ts",
    "worker:sweep": "bun run server/workers/sweep-worker.ts",
    "worker:walk-forward": "bun run server/workers/walk-forward-worker.ts",
    "worker:evaluator": "bun run server/workers/strategy-evaluator.ts",
    "typecheck:frontend": "tsc -p src/tsconfig.json --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "typecheck": "bun run typecheck:frontend && bun run typecheck:server",
    "check:db": "bun --env-file=.env run server/scripts/check-db-connection.ts",
    "smoke:screener-v4": "bun run server/scripts/screener-v4-smoke-test.ts",
    "enrich:nifty500": "bun run server/scripts/enrich-nifty500.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "use-sync-external-store": "^1.6.0",
    "ws": "^8"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@types/bun": "latest",
    "@types/ws": "^8.5.13",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  }
}
