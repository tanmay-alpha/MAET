SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_DB_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres?sslmode=require
UPSTASH_REDIS_URL=rediss://default:...@...upstash.io:6379
ANGELONE_MASTER_KEY=base64:32bytes
# Angel One SmartAPI credentials (TanmayQuant app).
# Paste real values into local .env (gitignored), NOT here.
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=
ALERT_WEBHOOK_URL=
# NSE_HOLIDAYS_JSON (optional, unset by default): JSON array of extra ISO dates
# merged with the bundled NSE holiday calendar, e.g. ["2026-11-09"].
# Optional BigQuery analytics sink. When unset, warehouse writes fail and are
# logged; Postgres persistence is unaffected.
BIGQUERY_PROJECT=
BIGQUERY_DATASET=
GOOGLE_APPLICATION_CREDENTIALS=
# Paper trading execution (non-secret)
PAPER_EXECUTION_MAX_QUOTE_AGE_MS=15000
PAPER_EXECUTION_ALLOW_DELAYED=false
PAPER_INITIAL_CASH_INR=1000000
# API rate limiting (token buckets per client IP and per signed-in user)
RATE_LIMIT_ENABLED=true
# Bucket store: memory (default, per instance) or redis (shared across instances)
RATE_LIMIT_STORE=memory
RATE_LIMIT_IP_CAPACITY=300
RATE_LIMIT_IP_REFILL_PER_SEC=5
RATE_LIMIT_USER_CAPACITY=120
RATE_LIMIT_USER_REFILL_PER_SEC=2
# Strategy Lab jobs (backtests, sweeps, walk-forward). The API process runs the
# queue itself unless STRATEGY_JOBS_IN_PROCESS=false (default: on, off in tests);
# set it to false when `bun run worker:strategy-jobs` runs the queue instead.
STRATEGY_JOBS_IN_PROCESS=true
# A single job still running after this many ms is failed (default 15 minutes).
STRATEGY_JOB_TIME_BUDGET_MS=900000
# Frontend (Vite). Inlined into the browser bundle: only public values here.
# VITE_SUPABASE_ANON_KEY is the Supabase anon key, which is public by design.
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
NODE_ENV=development
PORT=3000
